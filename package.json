{
  "name": "pisid3-lecture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "generate:content": "node scripts/generate-content.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "check:readiness": "node scripts/readiness.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts",
    "build": "npm run validate:content && tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "build:pages": "npm run build",
    "check:privacy": "node scripts/check-privacy.mjs",
    "export:pdf": "node scripts/export-pdf.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:notes": "node scripts/check-notes-storage.mjs",
    "audit:content": "node scripts/review-content.mjs",
    "check:methodology": "node scripts/check-methodology.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "test:tour": "node scripts/check-tour.mjs",
    "test:visuals": "node scripts/check-visuals.mjs",
    "test:interactions": "node scripts/review-release.mjs cases && node scripts/review-release.mjs tasks",
    "export:teaching": "node scripts/export-teaching.mjs",
    "test:experiments": "node scripts/check-question-experiments.mjs",
    "test:design": "node scripts/check-infographic-style.mjs",
    "generate:review": "npm run generate:content && npm run audit:inventory",
    "audit:inventory": "node scripts/quality.mjs inventory",
    "check:audit": "node scripts/quality.mjs check",
    "test:forms": "node scripts/check-form-artifacts.mjs",
    "test:components": "node scripts/check-components.mjs",
    "test:access": "node scripts/check-access-policy.mjs",
    "test:artifacts": "node scripts/check-working-artifacts.mjs",
    "test:models": "node scripts/check-course-models.mjs",
    "check:teaching": "node scripts/check-third-content.mjs"
  },
  "dependencies": {
    "@olgakraven/lecture-engine": "file:vendor/olgakraven-lecture-engine-0.2.0-course.5.tgz",
    "lucide-react": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsqr": "^1.4.0",
    "oxlint": "^1.79.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
